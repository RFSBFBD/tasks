# ============================================
# My Task — Environment Variables
# انسخ الملف ده لـ .env واملأ القيم الحقيقية
# متفتحش .env ده في Git أبدًا (هو متضاف في .gitignore)
# ============================================

# ---------- Django ----------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---------- PostgreSQL ----------
# لو شغال بالـ docker-compose، الـ host اسمه "db" زي ما هو في الملف
POSTGRES_DB=mytask
POSTGRES_USER=mytask_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mytask_user:change_me_strong_password@db:5432/mytask

# ---------- CORS / Frontend origin ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Clerk (Auth) ----------
# من Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# من Clerk Dashboard -> API Keys -> Show JWKS URL (غالبًا بيبقى على الشكل ده)
CLERK_JWKS_URL=https://your-app-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev

# ---------- Frontend (Next.js) ----------
# دول بيتحطوا في frontend/.env.local مش هنا، لكن متسيبينهمش في الكود
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ---------- MCP Server ----------
MCP_SERVER_PORT=8001
# نفس الـ DATABASE_URL بتاع فوق، الـ MCP بيقرأ منها مباشرة
MCP_DATABASE_URL=postgresql://mytask_user:change_me_strong_password@db:5432/mytask
